<!-- ═══════════════════════════════ PRICING ════════════════════════════════ -->
<section class="pricing-section section" id="pricing" aria-labelledby="pricing-title">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">تعرفه ها</span>
            <h2 id="pricing-title">طرح مناسب کسب وکار خود را انتخاب کنید</h2>
            <p class="section-desc">
                پلن ها متناسب با حجم کسب و کار شما آماده شده اند
            </p>
        </div>

        <div class="pricing-grid">

            <article class="pricing-card" aria-labelledby="plan-shared">
                <div class="pricing-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.85" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </div>
                <h3 id="plan-shared" class="pricing-plan-name">پلن اشتراکی</h3>
                <p class="pricing-plan-desc">
                    ربات و سرویس های شما روی یک VPS اشتراکی در کنار سایر مشتریان اجرا میشود.
                    جداسازی کامل داده و حریم خصوصی تضمین شده با هزینه های مقرون به صرفه.
                </p>
                <ul class="pricing-features">
                    <li>فقط ربات پشتیبان بله و تلگرام</li>
                    <li>جداسازی کامل داده و حریم خصوصی</li>
                    <li>پشتیبانی استاندارد</li>
                    <li>هزینه پایین تر</li>
                </ul>
                <div class="pricing-target">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.85" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                    مناسب برای فروشگاههای کوچک و استارتاپها
                </div>
                <a href="#contact" class="btn btn-ghost pricing-cta">درخواست مشاوره رایگان</a>
            </article>

            <article class="pricing-card pricing-card-featured" aria-labelledby="plan-dedicated">
                <span class="pricing-featured-badge" aria-label="پیشنهادی">پیشنهادی</span>
                <div class="pricing-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="8" rx="2" ry="2" />
                        <rect x="2" y="14" width="20" height="8" rx="2" ry="2" />
                        <line x1="6" y1="6" x2="6.01" y2="6" />
                        <line x1="6" y1="18" x2="6.01" y2="18" />
                    </svg>
                </div>
                <h3 id="plan-dedicated" class="pricing-plan-name">پلن اختصاصی</h3>
                <p class="pricing-plan-desc">
                    یک VPS کاملا مجزا و اختصاصی برای فروشگاه شما. پشتیبانی بدون تأخیر
